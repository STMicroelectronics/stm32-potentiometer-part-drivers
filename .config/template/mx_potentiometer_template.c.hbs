/**
  * @brief initialize the IO layer.
  * @param  pobj   : Potentiometer object
  * @retval error status.
  */
int32_t pot_io_init(pot_obj_t *pobj)
{
  /* Part Status */
  int ret = 0;

  switch (pobj->id)
  {
{{#each @root.pot_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{#with @root.ctx}}
    case POTENTIOMETER_{{@index}}:
      pobj->phadc        = POTENTIOMETER_{{@index}}_ADC_GETHANDLE();
      break;

{{/with}} {{!-- @root.ctx --}}
{{/each}} {{!-- @root.pot_instances --}}
    default:
      /* Error -- Unknown ID */
      ret = -1;
      break;
  }

  return ret;
}

